<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Список статей - Научный журнал</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }
        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        .nav-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .btn {
            background: white;
            color: #667eea;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 500;
            text-decoration: none;
            display: inline-block;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .btn-danger {
            background: #ff4757;
            color: white;
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        .controls {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .search-group {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }
        input, select {
            padding: 10px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            min-width: 200px;
        }
        .articles-list {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        .article-card {
            border-bottom: 1px solid #f0f0f0;
            padding: 20px;
            transition: background 0.2s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .article-card:hover {
            background: #f8f9ff;
        }
        .article-info {
            flex: 1;
        }
        .article-title {
            font-size: 1.2em;
            color: #764ba2;
            margin-bottom: 8px;
            font-weight: 600;
        }
        .article-meta {
            color: #666;
            font-size: 0.9em;
        }
        .article-actions {
            display: flex;
            gap: 10px;
        }
        .icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1.3em;
            padding: 8px;
            border-radius: 8px;
            transition: background 0.2s;
        }
        .icon-btn.view {
            color: #667eea;
        }
        .icon-btn.view:hover {
            background: #667eea20;
        }
        .icon-btn.delete {
            color: #ff4757;
        }
        .icon-btn.delete:hover {
            background: #ff475720;
        }
        .stats {
            background: linear-gradient(135deg, #667eea10 0%, #764ba210 100%);
            padding: 12px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            color: #667eea;
            font-weight: 500;
        }
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }
        .badge {
            background: linear-gradient(135deg, #667eea20 0%, #764ba220 100%);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            margin-right: 8px;
            display: inline-block;
            margin-top: 5px;
        }
        .date-range {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        input[type="date"] {
            padding: 8px 12px;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>📚 Научный электронный журнал</h1>
        <div class="nav-buttons">
            <a href="/" class="btn">🏠 Главная</a>
            <a href="/top-articles" class="btn btn-primary">🏆 Топ статей</a>
            <a href="/article/new" class="btn btn-primary">✏️ Создать статью</a>
        </div>
    </div>

    <div class="controls">
        <form action="/articles" method="GET">
            <button type="submit" class="btn">📖 Все статьи</button>
        </form>

        <form action="/search/title" method="POST" class="search-group">
            <input type="text" name="title" placeholder="Поиск по названию..." value="<%= searchQuery %>">
            <button type="submit" class="btn">🔍 Найти</button>
        </form>

        <form action="/search/author" method="POST" class="search-group">
            <select name="author">
                <option value="">Выберите автора</option>
                <% if (authors && authors.length > 0) { %>
                    <% authors.sort().forEach(author => { %>
                        <option value="<%= author %>" <%= selectedAuthor === author ? 'selected' : '' %>><%= author %></option>
                    <% }); %>
                <% } %>
            </select>
            <button type="submit" class="btn">👨‍🎓 Найти</button>
        </form>

        <form action="/search/date" method="POST" class="search-group">
            <div class="date-range">
                <input type="date" name="startDate" placeholder="Дата начала" value="<%= startDate %>">
                <span>—</span>
                <input type="date" name="endDate" placeholder="Дата окончания" value="<%= endDate %>">
            </div>
            <button type="submit" class="btn">📅 Поиск по дате</button>
        </form>
    </div>

    <div class="articles-list">
        <% if (articles && articles.length > 0) { %>
            <div class="stats">
                📊 Найдено статей: <strong><%= articles.length %></strong>
            </div>
            <% articles.forEach((article, index) => { %>
                <div class="article-card" data-id="<%= article._id %>">
                    <div class="article-info">
                        <div class="article-title">
                            <strong><%= index + 1 %>.</strong> <%= article.title %>
                        </div>
                        <div class="article-meta">
                            <span>✍️ Авторы: <%= article.authors.join(', ') %></span><br>
                            📅 Дата: <%= new Date(article.publishDate).toLocaleDateString('ru-RU') %><br>
                            🏷️ Теги: <% article.tags.forEach(tag => { %><span class="badge"><%= tag %></span><% }); %>
                            <% if (article.reviews && article.reviews.length > 0) { %>
                                <br>⭐ Рейтинг: <%= article.averageRating %>/10 (отзывов: <%= article.reviews.length %>)
                            <% } %>
                        </div>
                    </div>
                    <div class="article-actions">
                        <button class="icon-btn view" onclick="viewArticle('<%= article._id %>')" title="Просмотр">👁️</button>
                        <button class="icon-btn delete" onclick="deleteArticle('<%= article._id %>')" title="Удалить">🗑️</button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="no-results">
                😕 Статьи не найдены<br>
                <small>Попробуйте изменить параметры поиска</small>
            </div>
        <% } %>
    </div>
</div>

<script>
    function viewArticle(id) {
        window.location.href = `/article/${id}`;
    }

    async function deleteArticle(id) {
        if (confirm('Вы уверены, что хотите удалить эту статью?')) {
            try {
                const response = await fetch(`/article/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    const card = document.querySelector(`.article-card[data-id="${id}"]`);
                    if (card) {
                        card.remove();
                    }
                    const stats = document.querySelector('.stats');
                    if (stats) {
                        const remainingCards = document.querySelectorAll('.article-card').length;
                        if (remainingCards === 0) {
                            location.reload();
                        } else {
                            stats.innerHTML = `📊 Найдено статей: <strong>${remainingCards}</strong>`;
                        }
                    }
                } else {
                    alert('Ошибка при удалении статьи');
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка при удалении статьи');
            }
        }
    }
</script>
</body>
</html>