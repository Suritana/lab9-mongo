<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Научный журнал - Главная</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }
        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }
        .subtitle {
            opacity: 0.9;
        }
        .controls {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            transition: transform 0.2s, box-shadow 0.2s;
            font-weight: 500;
            text-decoration: none;
            display: inline-block;
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        .btn-secondary {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
        }
        .search-group {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }
        input, select {
            padding: 10px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            min-width: 220px;
            transition: border-color 0.3s;
        }
        input:focus, select:focus {
            outline: none;
            border-color: #667eea;
        }
        .articles-list {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        .article-card {
            border-bottom: 1px solid #f0f0f0;
            padding: 20px;
            transition: background 0.2s;
        }
        .article-card:hover {
            background: #f8f9ff;
            transform: translateX(5px);
        }
        .article-title {
            font-size: 1.3em;
            color: #764ba2;
            margin-bottom: 10px;
            font-weight: 600;
        }
        .article-meta {
            color: #666;
            font-size: 0.9em;
            line-height: 1.6;
        }
        .article-authors {
            color: #667eea;
            font-weight: 500;
        }
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #999;
            font-size: 1.1em;
        }
        .badge {
            background: linear-gradient(135deg, #667eea20 0%, #764ba220 100%);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            margin-right: 8px;
            display: inline-block;
            margin-top: 5px;
        }
        .stats {
            background: linear-gradient(135deg, #667eea10 0%, #764ba210 100%);
            padding: 12px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            color: #667eea;
            font-weight: 500;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .article-card {
            animation: fadeIn 0.3s ease-out;
        }
        .nav-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>📚 Научный электронный журнал</h1>
        <p class="subtitle">Современные исследования и разработки</p>
        <div class="nav-buttons">
            <a href="/articles" class="btn">📖 Список статей</a>
            <a href="/top-articles" class="btn btn-secondary">🏆 Топ статей</a>
            <a href="/article/new" class="btn btn-secondary">✏️ Создать статью</a>
        </div>
    </div>

    <div class="controls">
        <form action="/search/title" method="POST" class="search-group">
            <input type="text" name="title" placeholder="🔍 Введите название статьи..." value="<%= searchQuery %>">
            <button type="submit" class="btn">Поиск по названию</button>
        </form>

        <form action="/search/author" method="POST" class="search-group">
            <select name="author">
                <option value="">👨‍🎓 Выберите автора</option>
                <% if (authors && authors.length > 0) { %>
                    <% authors.sort().forEach(author => { %>
                        <option value="<%= author %>" <%= selectedAuthor === author ? 'selected' : '' %>><%= author %></option>
                    <% }); %>
                <% } %>
            </select>
            <button type="submit" class="btn">Поиск по автору</button>
        </form>

        <form action="/search/date" method="POST" class="search-group">
            <div class="search-group">
                <input type="date" name="startDate" placeholder="Дата начала">
                <span>—</span>
                <input type="date" name="endDate" placeholder="Дата окончания">
            </div>
            <button type="submit" class="btn">📅 Поиск по дате</button>
        </form>
    </div>

    <div class="articles-list">
        <% if (articles && articles.length > 0) { %>
            <div class="stats">
                📊 Найдено статей: <strong><%= articles.length %></strong>
            </div>
            <% articles.forEach((article, index) => { %>
                <div class="article-card">
                    <div class="article-title">
                        <%= index + 1 %>. <%= article.title %>
                    </div>
                    <div class="article-meta">
                        <span class="article-authors">✍️ Авторы: <%= article.authors.join(', ') %></span><br>
                        📅 Дата размещения: <%= new Date(article.publishDate).toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' }) %><br>
                        🏷️ Теги: <% article.tags.forEach(tag => { %><span class="badge"><%= tag %></span><% }); %>
                        <% if (article.reviews && article.reviews.length > 0) { %>
                            <br>⭐ Рейтинг: <%= (article.reviews.reduce((sum, r) => sum + r.rating, 0) / article.reviews.length).toFixed(1) %>/10
                            (на основе <%= article.reviews.length %> отзывов)
                        <% } %>
                    </div>
                </div>
            <% }); %>
        <% } else if (articles !== null) { %>
            <div class="no-results">
                😕 Статьи не найдены<br>
                <small>Попробуйте изменить параметры поиска</small>
            </div>
        <% } else { %>
            <div class="no-results">
                📌 Добро пожаловать в научный журнал!<br>
                <small>Нажмите "Список статей", чтобы просмотреть все публикации</small>
            </div>
        <% } %>
    </div>
</div>
</body>
</html>