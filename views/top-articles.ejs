<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Топ статей - Научный журнал</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }
        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        .btn {
            background: white;
            color: #667eea;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 20px;
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        .articles-list {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        .article-card {
            border-bottom: 1px solid #f0f0f0;
            padding: 20px;
            transition: background 0.2s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .article-card:hover {
            background: #f8f9ff;
        }
        .rank {
            font-size: 1.5em;
            font-weight: bold;
            min-width: 60px;
        }
        .rank-1 { color: #ffd700; }
        .rank-2 { color: #c0c0c0; }
        .rank-3 { color: #cd7f32; }
        .article-info {
            flex: 1;
            padding: 0 15px;
        }
        .article-title {
            font-size: 1.2em;
            color: #764ba2;
            margin-bottom: 8px;
            font-weight: 600;
        }
        .article-meta {
            color: #666;
            font-size: 0.9em;
        }
        .rating-info {
            text-align: right;
            min-width: 150px;
        }
        .rating-score {
            font-size: 1.8em;
            font-weight: bold;
            color: #667eea;
        }
        .rating-stars {
            color: #ffc107;
            font-size: 0.9em;
        }
        .badge {
            background: linear-gradient(135deg, #667eea20 0%, #764ba220 100%);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            margin-right: 8px;
            display: inline-block;
        }
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }
        .trophy {
            font-size: 1.5em;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>🏆 Топ статей журнала</h1>
        <p>Лучшие публикации по оценкам читателей</p>
        <a href="/articles" class="btn">← Назад к списку</a>
    </div>

    <div class="articles-list">
        <% if (articles && articles.length > 0) { %>
            <% articles.forEach((article, index) => { %>
                <div class="article-card">
                    <div class="rank">
                        <% if (index === 0) { %>
                            <span class="trophy">🥇</span>
                        <% } else if (index === 1) { %>
                            <span class="trophy">🥈</span>
                        <% } else if (index === 2) { %>
                            <span class="trophy">🥉</span>
                        <% } else { %>
                            <span><%= index + 1 %></span>
                        <% } %>
                    </div>
                    <div class="article-info">
                        <div class="article-title"><%= article.title %></div>
                        <div class="article-meta">
                            ✍️ <%= article.authors.join(', ') %><br>
                            📅 <%= new Date(article.publishDate).toLocaleDateString('ru-RU') %><br>
                            🏷️ <% article.tags.forEach(tag => { %><span class="badge"><%= tag %></span><% }); %>
                        </div>
                    </div>
                    <div class="rating-info">
                        <div class="rating-score"><%= article.averageRating %></div>
                        <div class="rating-stars">
                            <% const rating = parseFloat(article.averageRating); %>
                            <% for(let i=1; i<=5; i++) { %>
                                <% if (rating/2 >= i) { %>
                                    ★
                                <% } else if (rating/2 >= i-0.5) { %>
                                    ☆
                                <% } else { %>
                                    ☆
                                <% } %>
                            <% } %>
                        </div>
                        <div class="article-meta">💬 <%= article.reviewCount %> отзывов</div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="no-results">
                😕 Нет статей с оценками
            </div>
        <% } %>
    </div>
</div>
</body>
</html>